# Variables d'environnement — copier en .env et adapter

# Base de données PostgreSQL
DATABASE_URL=postgresql+asyncpg://poc:poc@localhost:5432/poc_mqtt

# Broker MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=machines/events
MQTT_CLIENT_ID=poc-backend
MQTT_RECONNECT_DELAY=5

# Application
LOG_LEVEL=INFO
API_TITLE=PoC MQTT FastAPI
API_VERSION=0.1.0

